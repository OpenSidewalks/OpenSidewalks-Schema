<?xml version="1.0" encoding="UTF-8"?>
<presets
	xmlns="http://josm.openstreetmap.de/tagging-preset-1.0"
	author="Amy Bordenave, Taskar Center for Accessible Technology"
	version="15"
	description="OpenSidewalks Schema version 0.3"
	shortdescription="OpenSidewalks Schema v0.3"
	link="https://github.com/OpenSidewalks/OpenSidewalks-Schema"
	icon="https://raw.githubusercontent.com/TaskarCenterAtUW/tcat-wiki/6c2e9c412eaa8c57dd52a7f3ea3343f671e28934/docs/resources/images/accessmap/accessmap-logo.png"
>
	<group name="OpenSidewalks Schema v0.3">
		<!-- CORE ENTITIES -->
		<group name="01. Core Entities">
			<!-- CORE NODES -->
			<group name="01. Nodes">
				<item name="01. Generic Curb" type="node">
					<label text="A curb for which a type has not been determined yet or could not be determined despite some effort." />
					<combo key="barrier" text="Feature Type" values="kerb" display_values="Curb" default="kerb" editable="false" />
					<combo key="tactile_paving" text="Tactile Paving" values="yes,no,contrasted,primitive" display_values="Yes,No,Contrasting Surface,Surface Roughness Treatment" editable="false" />
				</item>
				<item name="02. Raised Curb" type="node">
					<label text="A single, designed vertical displacement that separates two edges." />
					<combo key="barrier" text="Feature Type" values="kerb" display_values="Curb" default="kerb" editable="false" />
					<combo key="kerb" text="Curb Type" values="raised" display_values="Raised Curb" default="raised" editable="false" />
					<combo key="tactile_paving" text="Tactile Paving" values="yes,no,contrasted,primitive" display_values="Yes,No,Contrasting Surface,Surface Roughness Treatment" editable="false" />
				</item>
				<item name="03. Curb Ramp" type="node">
					<label text="A curb ramp (curb cut, lowered curb) mapped as a curb interface." />
					<combo key="barrier" text="Feature Type" values="kerb" display_values="Curb" default="kerb" editable="false" />
					<combo key="kerb" text="Curb Type" values="lowered" display_values="Curb Ramp" default="lowered" editable="false" />
					<combo key="tactile_paving" text="Tactile Paving" values="yes,no,contrasted,primitive" display_values="Yes,No,Contrasting Surface,Surface Roughness Treatment" editable="false" />
				</item>
				<item name="04. Flush Curb" type="node">
					<label text="A curb interface where there is no noticeable discontinuity in elevation." />
					<combo key="barrier" text="Feature Type" values="kerb" display_values="Curb" default="kerb" editable="false" />
					<combo key="kerb" text="Curb Type" values="flush" display_values="Flush Curb" default="flush" editable="false" />
					<combo key="tactile_paving" text="Tactile Paving" values="yes,no,contrasted,primitive" display_values="Yes,No,Contrasting Surface,Surface Roughness Treatment" editable="false" />
				</item>
				<item name="05. Rolled Curb" type="node">
					<label text="A curb interface with a quarter-circle profile." />
					<combo key="barrier" text="Feature Type" values="kerb" display_values="Curb" default="kerb" editable="false" />
					<combo key="kerb" text="Curb Type" values="rolled" display_values="Rolled Curb" default="rolled" editable="false" />
					<combo key="tactile_paving" text="Tactile Paving" values="yes,no,contrasted,primitive" display_values="Yes,No,Contrasting Surface,Surface Roughness Treatment" editable="false" />
				</item>
			</group>
			<!-- CORE EDGES -->
			<group name="02. Edges">
				<item name="01. Sidewalk" type="way">
					<label text="The centerline of a sidewalk, a designated pedestrian path to the side of a street." />
					<combo key="highway" text="Feature Type" values="footway" display_values="Footway" default="footway" editable="false" />
					<combo key="footway" text="Footway Type" values="sidewalk" display_values="Sidewalk" default="sidewalk" editable="false" />
					<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
					<text key="width" text="Width (meters)" />
					<text key="incline" text="Incline (-1 to 1)" />
					<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
				</item>
				<item name="02. Crossing" type="way">
					<label text="The centerline of a pedestrian street crossing." />
					<combo key="highway" text="Feature Type" values="footway" display_values="Footway" default="footway" editable="false" />
					<combo key="footway" text="Footway Type" values="crossing" display_values="Crossing" default="crossing" editable="false" />
					<combo key="crossing:markings" text="Crossing Markings" values="dashes,dots,ladder,ladder:paired,lines,lines:paired,no,skewed,surface,yes,zebra,zebra:bicolour,zebra:double,zebra:paired,rainbow,lines:rainbow,zebra:rainbow,ladder:skewed,pictograms" display_values="Dashes,Dots,Ladder,Ladder (paired),Lines,Lines (paired),None,Skewed,Surface,Yes (Generic),Zebra,Zebra (bicolour),Zebra (double),Zebra (paired),Rainbow,Lines (rainbow),Zebra (rainbow),Ladder (skewed),Pictograms" />
					<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
					<text key="width" text="Width (meters)" />
					<text key="incline" text="Incline (-1 to 1)" />
					<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
				</item>
				<item name="03. Footway (Generic)" type="way">
					<label text="The centerline of a dedicated pedestrian path that does not fall into any other subcategories. Also used for connectors." />
					<combo key="highway" text="Feature Type" values="footway" display_values="Footway" default="footway" editable="false" />
					<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
					<text key="width" text="Width (meters)" />
					<text key="incline" text="Incline (-1 to 1)" />
					<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
				</item>
				<item name="04. Traffic Island" type="way">
					<label text="The centerline of a footway traversing a traffic island." />
					<combo key="highway" text="Feature Type" values="footway" display_values="Footway" default="footway" editable="false" />
					<combo key="footway" text="Footway Type" values="traffic_island" display_values="Traffic Island" default="traffic_island" editable="false" />
					<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
					<text key="width" text="Width (meters)" />
					<text key="incline" text="Incline (-1 to 1)" />
					<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
				</item>
				<item name="05. Steps" type="way">
					<label text="The centerline of a flight of steps on footways and paths." />
					<combo key="highway" text="Feature Type" values="steps" display_values="Steps/Stairs" default="steps" editable="false" />
					<text key="step_count" text="Number of Steps" />
					<combo key="climb" text="Climb Direction" values="up,down" display_values="Up,Down" editable="false" />
					<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
					<text key="width" text="Width (meters)" />
					<text key="incline" text="Incline (-1 to 1)" />
					<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
				</item>
				<item name="06. Pedestrian Road" type="way">
					<label text="The centerline of a road or an area mainly or exclusively for pedestrians in which some vehicle traffic may be authorized." />
					<combo key="highway" text="Feature Type" values="pedestrian" display_values="Pedestrian Road" default="pedestrian" editable="false" />
					<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
					<text key="width" text="Width (meters)" />
					<text key="incline" text="Incline (-1 to 1)" />
					<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
				</item>
				<item name="07. Living Street" type="way">
					<label text="A street designed with the interests of pedestrians and cyclists in mind by providing enriching and experiential spaces." />
					<combo key="highway" text="Feature Type" values="living_street" display_values="Living Street" default="living_street" editable="false" />
					<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
					<text key="width" text="Width (meters)" />
					<text key="incline" text="Incline (-1 to 1)" />
					<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
				</item>
				<group name="08. Motor Vehicle Roads">
					<item name="01. Trunk Road" type="way">
						<label text="The most important roads in a country's system." />
						<combo key="highway" text="Feature Type" values="trunk" display_values="Trunk Road" default="trunk" editable="false" />
						<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
						<text key="width" text="Width (meters)" />
						<text key="incline" text="Incline (-1 to 1)" />
						<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
					</item>
					<item name="02. Primary Street" type="way">
						<label text="The centerline of a major highway." />
						<combo key="highway" text="Feature Type" values="primary" display_values="Primary Street" default="primary" editable="false" />
						<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
						<text key="width" text="Width (meters)" />
						<text key="incline" text="Incline (-1 to 1)" />
						<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
					</item>
					<item name="03. Secondary Street" type="way">
						<label text="The centerline of a secondary highway: not a major highway, but forms a major link in the national route network." />
						<combo key="highway" text="Feature Type" values="secondary" display_values="Secondary Street" default="secondary" editable="false" />
						<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
						<text key="width" text="Width (meters)" />
						<text key="incline" text="Incline (-1 to 1)" />
						<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
					</item>
					<item name="04. Tertiary Street" type="way">
						<label text="A road linking small settlements, or the local centers of a large town or city." />
						<combo key="highway" text="Feature Type" values="tertiary" display_values="Tertiary Street" default="tertiary" editable="false" />
						<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
						<text key="width" text="Width (meters)" />
						<text key="incline" text="Incline (-1 to 1)" />
						<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
					</item>
					<item name="05. Unclassified Road" type="way">
						<label text="The least important through roads in a country's system." />
						<combo key="highway" text="Feature Type" values="unclassified" display_values="Unclassified Road" default="unclassified" editable="false" />
						<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
						<text key="width" text="Width (meters)" />
						<text key="incline" text="Incline (-1 to 1)" />
						<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
					</item>
					<item name="06. Residential Street" type="way">
						<label text="A residential street." />
						<combo key="highway" text="Feature Type" values="residential" display_values="Residential Street" default="residential" editable="false" />
						<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
						<text key="width" text="Width (meters)" />
						<text key="incline" text="Incline (-1 to 1)" />
						<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
					</item>
					<item name="07. Service Road" type="way">
						<label text="A road intended for service use." />
						<combo key="highway" text="Feature Type" values="service" display_values="Service Road" default="service" editable="false" />
						<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
						<text key="width" text="Width (meters)" />
						<text key="incline" text="Incline (-1 to 1)" />
						<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
					</item>
					<item name="08. Driveway" type="way">
						<label text="The centerline of a driveway. Typically connects a residence to another road." />
						<combo key="highway" text="Feature Type" values="service" display_values="Service Road" default="service" editable="false" />
						<combo key="service" text="Service Road Type" values="driveway" display_values="Driveway" default="driveway" editable="false" />
						<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
						<text key="width" text="Width (meters)" />
						<text key="incline" text="Incline (-1 to 1)" />
						<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
					</item>
					<item name="09. Alley" type="way">
						<label text="The centerline of an alley. An alley is usually located between properties and provides access to utilities and private entrances." />
						<combo key="highway" text="Feature Type" values="service" display_values="Service Road" default="service" editable="false" />
						<combo key="service" text="Service Road Type" values="alley" display_values="Alley" default="alley" editable="false" />
						<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
						<text key="width" text="Width (meters)" />
						<text key="incline" text="Incline (-1 to 1)" />
						<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
					</item>
					<item name="10. Parking Aisle" type="way">
						<label text="The centerline of a subordinated way in a parking lot: vehicles drive on parking aisles to reach parking spaces in a parking lot." />
						<combo key="highway" text="Feature Type" values="service" display_values="Service Road" default="service" editable="false" />
						<combo key="service" text="Service Road Type" values="parking_aisle" display_values="Parking Aisle" default="parking_aisle" editable="false" />
						<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
						<text key="width" text="Width (meters)" />
						<text key="incline" text="Incline (-1 to 1)" />
						<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
					</item>
				</group>
			</group>
			<!-- CORE ZONES -->
			<group name="03. Zones">
				<item name="01. Pedestrian Zone" type="closedway,multipolygon">
					<label text="An area where pedestrians can travel freely in all directions." />
					<combo key="highway" text="Feature Type" values="pedestrian" display_values="Pedestrian Zone" default="pedestrian" editable="false" />
					<combo key="surface" text="Surface Material" values="asphalt,concrete,paving_stones,gravel,dirt,grass,grass_paver,paved,unpaved" display_values="Asphalt,Concrete,Paving Stones/Bricks,Gravel,Dirt,Grass,Grass Paver,Paved (Generic),Unpaved (Generic)" editable="false" />
					<combo key="foot" text="Foot Access" values="yes,designated,destination,permissive,no,private,use_sidepath" editable="false" />
				</item>
			</group>
		</group>
		<!-- ADJACENT ENTITIES -->
		<group name="02. Adjacent Entities">
			<!-- ADJACENT POINTS -->
			<group name="01. Points">
				<item name="01. Power Pole" type="node">
					<label text="A power pole. Often made of wood or metal, they hold power lines." />
					<combo key="power" text="Feature Type" values="pole" display_values="Power Pole" default="pole" editable="false" />
				</item>
				<item name="02. Fire Hydrant" type="node">
					<label text="A fire hydrant - where fire response teams connect high-pressure hoses." />
					<combo key="emergency" text="Feature Type" values="fire_hydrant" display_values="Fire Hydrant" default="fire_hydrant" editable="false" />
				</item>
				<item name="03. Bench" type="node">
					<label text="A bench - a place for people to sit; allows room for several people." />
					<combo key="amenity" text="Feature Type" values="bench" display_values="Bench" default="bench" editable="false" />
				</item>
				<item name="04. Bollard" type="node">
					<label text="A bollard - a solid pillar or pillars made of concrete, metal, plastic, etc., used to control traffic." />
					<combo key="barrier" text="Feature Type" values="bollard" display_values="Bollard" default="bollard" editable="false" />
				</item>
				<item name="05. Manhole" type="node">
					<label text="A manhole - a hole with a cover that allows access to an underground service location." />
					<combo key="man_made" text="Feature Type" values="manhole" display_values="Manhole" default="manhole" editable="false" />
				</item>
				<item name="06. Street Lamp" type="node">
					<label text="A street lamp - a street light, lamppost, street lamp, light standard, or lamp standard." />
					<combo key="highway" text="Feature Type" values="street_lamp" display_values="Streetlight" default="street_lamp" editable="false" />
				</item>
				<item name="07. Waste Basket" type="node">
					<label text="A waste basket - a single small container for depositing garbage accessible for pedestrians." />
					<combo key="amenity" text="Feature Type" values="waste_basket" display_values="Trash Can" default="waste_basket" editable="false" />
				</item>
			</group>
			<!-- ADJACENT LINES -->
			<group name="02. Lines">
				<item name="01. Fence" type="way,closedway">
					<label text="A fence is a freestanding structure designed to restrict or prevent movement across a boundary." />
					<combo key="barrier" text="Feature Type" values="fence" display_values="Fence" default="fence" editable="false" />
				</item>
			</group>
			<!-- ADJACENT POLYGONS -->
			<group name="03. Polygons">
				<item name="01. Building" type="closedway,multipolygon">
