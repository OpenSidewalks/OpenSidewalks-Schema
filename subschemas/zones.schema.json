        "CustomZone": {
            "additionalProperties": false,
            "description": "A custom zone is a user-defined Polygon feature which is traversible. It can represent any custom zone (e.g., a public grassy zone).",
            "properties": {
                "bbox": {
                    "anyOf": [
                        {
                            "items": [
                                {
                                    "type": "number"
                                },
